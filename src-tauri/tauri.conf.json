{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aura VTC Hub",
  "version": "1.0.2",
  "identifier": "com.auravtc.hub",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:8080",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aura VTC Hub",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "center": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/**"
        ]
      },
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost https: http: data: blob:; connect-src 'self' https://*.supabase.co https://api.truckersmp.com https://discord.com https://*.discord.com wss://*.supabase.co; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Aura VTC",
    "copyright": "© 2026 Aura VTC",
    "category": "Utility",
    "shortDescription": "Aura VTC Hub",
    "longDescription": "Fleet management hub for Euro Truck Simulator 2 VTC",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/icon.png",
        "sidebarImage": "icons/icon.png"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3NEQyRjAxOURDMDY1RDYKUldUV1pjQ2RBUzlOMS9yZ2FteWovRWJxYXJ3alMvRHUwTXA4TzZsWUlYN0tBN3RTRkhOb3c3bzkK",
      "endpoints": [
        "https://raw.githubusercontent.com/Chetan302003/Aura-Hub/refs/heads/main/updater.json"
      ]
    }
  }
}